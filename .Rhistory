library(shiny)
library(shinydashboard)
ui <- dashboardPage(
dashboardHeader(title = "Dynamic Sidebar"),
dashboardSidebar(
selectInput("menu_control", "Choose a section:", choices = c("Main", "Advanced")),
sidebarMenuOutput("dynamicSidebar")
),
dashboardBody(
tabItems(
tabItem(tabName = "dashboard", h2("Main Dashboard")),
tabItem(tabName = "settings", h2("Settings Page")),
tabItem(tabName = "advanced", h2("Advanced Analytics")),
tabItem(tabName = "admin", h2("Admin Panel"))
)
)
)
server <- function(input, output, session) {
session$onSessionEnded(function() {
stopApp()
})
output$dynamicSidebar <- renderMenu({
if (input$menu_control == "Main") {
sidebarMenu(id = "tabs",
menuItem("Dashboard", tabName = "dashboard", icon = icon("dashboard")),
menuItem("Settings", tabName = "settings", icon = icon("sliders-h"))
)
} else {
sidebarMenu(id = "tabs",
menuItem("Advanced Analytics", tabName = "advanced", icon = icon("chart-line")),
menuItem("Admin Panel", tabName = "admin", icon = icon("user-shield"))
)
}
})
}
shinyApp(ui, server)
library(shiny)
