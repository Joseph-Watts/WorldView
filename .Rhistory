}
index_html <- paste(readLines(index_path, warn = FALSE), collapse = "\n")
old_summary <- '<section id="page-summary" class="page" data-page="summary" hidden>
<div class="page-heading"><p class="eyebrow">Explore one variable</p><h1>Summary statistics</h1></div>
<div class="coming-soon"><h2>Application shell ready</h2><p>This page will be implemented in the next stage.</p></div>
</section>'
new_summary <- '<section id="page-summary" class="page" data-page="summary" hidden>
<div class="page-heading">
<p class="eyebrow">Explore one variable</p>
<h1>Summary statistics</h1>
<p>Select a variable and one or more countries. Statistics use the processed WorldView teaching sample.</p>
</div>
<div id="summary-loading" class="notice" aria-live="polite">Loading data...</div>
<form id="summary-form" class="analysis-layout" hidden>
<aside class="control-panel">
<h2>Choose data</h2>
