library(shiny)
library(DT)
library(dplyr)
# Sample data
country_data <- data.frame(
country = c("New Zealand", "Australia", "Canada", "Germany", "Brazil"),
population_millions = c(5.1, 25.7, 38.2, 83.2, 213.3),
region = c("Oceania", "Oceania", "Americas", "Europe", "Americas")
)
# UI
ui <- fluidPage(
titlePanel("Country Data Viewer"),
sidebarLayout(
sidebarPanel(
selectInput(
inputId = "selected_country",
label = "Select a country:",
choices = unique(country_data$country),
selected = "New Zealand"
)
),
mainPanel(
DTOutput("filtered_table")
)
)
)
# Server
server <- function(input, output, session) {
session$onSessionEnded(function() {
stopApp()
})
filtered_data <- reactive({
country_data %>%
filter(country == input$selected_country)
})
output$filtered_table <- renderDT({
datatable(filtered_data(), options = list(pageLength = 5))
})
}
# Run the app
shinyApp(ui, server)
runApp()
