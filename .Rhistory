margin-top: 30px;
margin-bottom: 25px;
}
/* Card styling */
.team-card {
padding: 25px 20px;
margin-bottom: 30px;
box-shadow: 0 5px 15px rgba(0,0,0,0.08);
border-radius: 10px;
text-align: center;
background: white;
height: 100%;
transition: all 0.3s ease;
}
.team-card:hover {
transform: translateY(-8px);
box-shadow: 0 8px 25px rgba(0,0,0,0.12);
}
.profile-img {
width: 150px;
height: 150px;
object-fit: cover;
border-radius: 50%;
border: 4px solid #f1f8ff;
margin: 0 auto 20px;
}
.member-name {
color: #2c3e50;
font-weight: 700;
margin-top: 15px;
font-size: 1.4em;
}
.member-role {
color: #3498db;
font-weight: 600;
margin-bottom: 15px;
font-size: 1.1em;
}
.member-bio {
color: #34495e;
line-height: 1.6;
}
/* Past members styling */
