background-color: #f8f9fa;
border: 1px solid #eee;
}
.past-members .member-role {
color: #7f8c8d;
}
"))
),
titlePanel(h1("About Our Team", style = "color: #2c3e50; text-align: center;")),
# Loop through roles (except Past Members)
lapply(names(team_data)[1:(length(team_data)-1)], function(role) {
section <- tagList(
h2(class = "section-title", role),
fluidRow(
lapply(1:nrow(team_data[[role]]), function(i) {
member <- team_data[[role]][i, ]
column(
width = ifelse(nrow(team_data[[role]]) > 1, 6, 4),
offset = ifelse(nrow(team_data[[role]]) == 1, 4, 0),
div(
class = "team-card",
img(
src = member$image,
class = "profile-img",
alt = paste(member$name, "profile photo")
),
h3(class = "member-name", member$name),
h4(class = "member-role", member$role),
p(class = "member-bio", member$bio)
)
)
})
)
)
return(section)
}),
# Past Members section
div(
class = "past-members",
h2(class = "section-title", "Past Members"),
fluidRow(
lapply(1:nrow(team_data[["Past Members"]]), function(i) {
member <- team_data[["Past Members"]][i, ]
column(
width = 4,
div(
class = "team-card",
img(
