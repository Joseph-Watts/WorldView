tags$head(
tags$style(HTML("
/* Overall styling */
body {
background-color: #f8f9fa;
font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}
.section-title {
color: #2c3e50;
border-bottom: 2px solid #3498db;
