library(shiny)
ui <- fluidPage(
tags$head(
tags$script(HTML("
Shiny.addCustomMessageHandler('navigate', function(dir) {
// Get the currently active tab
var currentTab = $('ul.nav.nav-tabs .active a').attr('data-value');
// Get all the tabs
var allTabs = $('ul.nav.nav-tabs li a').map(function() {
return $(this).attr('data-value');
}).get();
// Find the index of the current tab
var currentIndex = allTabs.indexOf(currentTab);
// Determine the next tab to navigate to
if (dir === 'next' && currentIndex < allTabs.length - 1) {
var nextTab = allTabs[currentIndex + 1];
$('a[data-value=\"' + nextTab + '\"]').tab('show');
} else if (dir === 'prev' && currentIndex > 0) {
var prevTab = allTabs[currentIndex - 1];
$('a[data-value=\"' + prevTab + '\"]').tab('show');
}
});
"))
),
navbarPage(
title = "Shiny App",
id = "mainNav",
tabPanel(
title = "Page 1",
value = "page1",
h3("This is Page 1"),
actionButton("prev1", "Previous"),
actionButton("next1", "Next")
),
tabPanel(
title = "Page 2",
value = "page2",
h3("This is Page 2"),
actionButton("prev2", "Previous"),
actionButton("next2", "Next")
),
tabPanel(
title = "Page 3",
value = "page3",
h3("This is Page 3"),
actionButton("prev3", "Previous"),
actionButton("next3", "Next")
)
)
)
server <- function(input, output, session) {
# Next and Previous navigation handlers
observeEvent(input$next1, {
session$sendCustomMessage("navigate", "next")
})
observeEvent(input$prev2, {
session$sendCustomMessage("navigate", "prev")
})
observeEvent(input$next2, {
session$sendCustomMessage("navigate", "next")
})
observeEvent(input$prev3, {
session$sendCustomMessage("navigate", "prev")
})
}
shinyApp(ui, server)
library(shiny)
library(glue)
ui <- fluidPage(
actionButton(inputId = "back", label = "Back"),
actionButton(inputId = "forward", label = "Next"),
textOutput("narrative")
)
server <- function(input, output, session){
observeEvent(input$back, {
message(glue("The user clicked the `Back` button. It's value is now {input$back}"))
})
observeEvent(input$forward, {
message(glue("The user clicked the `Next` button. It's value is now {input$forward}"))
})
output$narrative <- renderText(glue("Back is {input$back}. Forward is {input$forward}"))
}
shinyApp(ui, server)
