library(shiny)
library(leaflet)
library(rnaturalearth)
library(rnaturalearthdata)
library(dplyr)
library(sf)
# Load Natural Earth countries
world <- ne_countries(scale = "medium", returnclass = "sf") %>%
mutate(
iso_a3 = as.character(iso_a3),
hover_label = paste0("<strong>", name, "</strong><br/>Population: ", scales::comma(pop_est))
)
# Define a limited set of selectable countries (by alpha-3 code)
allowed_iso <- levels(orig_country_data$B_COUNTRY_ALPHA)
# Subset of selectable countries
selectable_countries <- world %>% filter(iso_a3 %in% allowed_iso)
non_selectable_countries <- world %>% filter(!iso_a3 %in% allowed_iso)
# UI
ui <- fluidPage(
titlePanel("Select Countries by Map or List (Limited Set)"),
fluidRow(
column(
width = 4,
selectInput(
inputId = "country_select",
label = "Select a country:",
choices = sort(selectable_countries$name),
selected = NULL,
multiple = TRUE,
selectize = TRUE
),
actionButton("clear_btn", "Clear Selection", icon = icon("eraser"))
)
),
leafletOutput("countryMap", height = "600px")
)
# Server
server <- function(input, output, session) {
session$onSessionEnded(function() {
stopApp()
})
# Track selected ISO codes
selected <- reactiveValues(codes = character())
# Render the map
output$countryMap <- renderLeaflet({
leaflet() %>%
addProviderTiles(providers$CartoDB.Positron) %>%
# Non-selectable (background) countries
addPolygons(
data = non_selectable_countries,
fillColor = "gainsboro",
fillOpacity = 0.4,
color = "white",
weight = 1,
label = NULL,
highlightOptions = highlightOptions(weight = 0)  # no interaction
) %>%
# Selectable countries (initially unselected)
addPolygons(
data = selectable_countries,
layerId = ~iso_a3,
fillColor = "lightgray",
fillOpacity = 0.5,
color = "white",
weight = 1,
label = lapply(selectable_countries$hover_label, HTML),
highlightOptions = highlightOptions(weight = 2, color = "#333", bringToFront = TRUE)
)
})
# Handle clicks on selectable countries
observeEvent(input$countryMap_shape_click, {
clicked_id <- input$countryMap_shape_click$id
if (!is.null(clicked_id) && clicked_id %in% allowed_iso) {
if (clicked_id %in% selected$codes) {
selected$codes <- setdiff(selected$codes, clicked_id)
} else {
selected$codes <- unique(c(selected$codes, clicked_id))
}
# Update the dropdown
updateSelectInput(
session,
"country_select",
selected = selectable_countries$name[selectable_countries$iso_a3 %in% selected$codes]
)
}
})
# Handle dropdown selection
observeEvent(input$country_select, {
selected$codes <- selectable_countries %>%
filter(name %in% input$country_select) %>%
pull(iso_a3)
})
# Clear selection
observeEvent(input$clear_btn, {
selected$codes <- character()
updateSelectInput(session, "country_select", selected = character())
})
# Highlight selected countries
observe({
selected_sf <- selectable_countries %>% filter(iso_a3 %in% selected$codes)
unselected_sf <- selectable_countries %>% filter(!iso_a3 %in% selected$codes)
leafletProxy("countryMap") %>%
clearGroup("selected")
# Add unselected countries (light gray)
if (nrow(unselected_sf) > 0) {
leafletProxy("countryMap") %>%
addPolygons(
data = unselected_sf,
layerId = ~iso_a3,
group = "selected",
fillColor = "lightgray",
fillOpacity = 0.5,
color = "white",
weight = 1,
label = lapply(unselected_sf$hover_label, HTML),
highlightOptions = highlightOptions(weight = 2, color = "#333", bringToFront = TRUE)
)
}
# Add selected countries (steel blue)
if (nrow(selected_sf) > 0) {
leafletProxy("countryMap") %>%
addPolygons(
data = selected_sf,
layerId = ~iso_a3,
group = "selected",
fillColor = "steelblue",
fillOpacity = 0.7,
color = "black",
weight = 2,
label = lapply(selected_sf$hover_label, HTML),
highlightOptions = highlightOptions(weight = 2, color = "#333", bringToFront = TRUE)
)
}
})
}
# Run the app
shinyApp(ui, server)
sort(unique(world$iso_a3_eh), decreasing = F)
runApp('Support_Files/test_area2.R')
levels(orig_country_data$B_COUNTRY_ALPHA)
sort(levels(orig_country_data$B_COUNTRY_ALPHA), decreasing = F)
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp()
runApp('Support_Files/test_area2.R')
gc()
runApp()
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp('Support_Files/test_area2.R')
runApp()
runApp()
runApp()
view(selected_countries)
view(selected_countries)
exit
quit
