<span>Countries</span>
<select id="summary-countries" multiple size="10" aria-describedby="country-help"></select>
</label>
<p id="country-help" class="field-help">Select one or more countries. Use Ctrl or Command to select several. If none are selected, all countries are combined.</p>
<fieldset class="radio-group">
<legend>Multiple-country output</legend>
<label><input type="radio" name="summary-mode" value="combined" checked> Combine selected countries</label>
